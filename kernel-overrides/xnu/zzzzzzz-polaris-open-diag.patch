--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -4577,7 +4577,16 @@
  *	vnode_setsize:???
  *
  * XXX Need to implement uid, gid
+ */
+/*
+ * Polaris bring-up probe state, shared between the entry probe and the
+ * return probes further down in open1(). Only meaningful for PID 1.
  */
+static char polaris_cache_path[96];
+static int polaris_cache_hit;
+static long long polaris_cache_size;
+static int polaris_openres;
+
 int
 open1(vfs_context_t ctx, struct nameidata *ndp, int uflags,
     struct vnode_attr *vap, fp_initfn_t fp_init, void *initarg, int32_t *retval, int authfd)
@@ -4594,6 +4603,53 @@
 
 	oflags = uflags;
 
+	/*
+	 * Polaris bring-up probe. Records whether PID 1 is opening the dyld
+	 * shared cache and, when polaris-openres is set, reports the result
+	 * at every return path below. Inert without the boot argument.
+	 */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		extern char *strnstr(const char *, const char *, size_t);
+		static int polaris_probe_ready;
+		static int polaris_openprobe;
+		static int polaris_opencount;
+		if (!polaris_probe_ready) {
+			int probe_value = 0;
+			int res_value = 0;
+			(void)PE_parse_boot_argn("polaris-openprobe", &probe_value,
+			    sizeof(probe_value));
+			(void)PE_parse_boot_argn("polaris-openres", &res_value,
+			    sizeof(res_value));
+			polaris_openprobe = probe_value;
+			polaris_openres = res_value;
+			polaris_probe_ready = 1;
+		}
+		polaris_cache_hit = 0;
+		polaris_cache_size = -1;
+		if (p != PROC_NULL && proc_getpid(p) == 1 &&
+		    UIO_SEG_IS_USER_SPACE(ndp->ni_segflg)) {
+			char probe_path[160] = {0};
+			size_t probe_len = 0;
+			if (copyinstr(ndp->ni_dirp, probe_path,
+			    sizeof(probe_path) - 1, &probe_len) == 0 &&
+			    strnstr(probe_path, "dyld_shared_cache",
+			    sizeof(probe_path)) != NULL) {
+				polaris_opencount++;
+				if (polaris_openprobe > 0 &&
+				    polaris_opencount == polaris_openprobe) {
+					panic("POLARIS OPEN #%d %s flags=%x",
+					    polaris_opencount, probe_path, oflags);
+				}
+				if (polaris_openres) {
+					strlcpy(polaris_cache_path, probe_path,
+					    sizeof(polaris_cache_path));
+					polaris_cache_hit = 1;
+				}
+			}
+		}
+	}
+
 	amode = oflags & O_ACCMODE;
 	/*
 	 * Because O_RDONLY is 0, it is not possible to distinguish between
@@ -4654,6 +4710,10 @@
 			error = EINTR;
 		}
 		fp_free(p, indx, fp);
+		if (polaris_cache_hit) {
+			panic("POLARIS OPENRES vnopen err=%d %s", error,
+			    polaris_cache_path);
+		}
 		return error;
 	}
 
@@ -4668,6 +4728,13 @@
 	fp->fp_glob->fg_ops = &vnops;
 	fp_set_data(fp, vp);
 
+	if (polaris_cache_hit) {
+		off_t polaris_sz = 0;
+		if (vnode_size(vp, &polaris_sz, ctx) == 0) {
+			polaris_cache_size = (long long)polaris_sz;
+		}
+	}
+
 #if CONFIG_FILE_LEASES
 	/*
 	 * If we are creating a file or open with truncate, we need to break the
@@ -4857,6 +4924,11 @@
 	proc_fdunlock(p);
 
 	*retval = indx;
+
+	if (polaris_cache_hit) {
+		panic("POLARIS OPENRES ok fd=%d size=%lld %s", indx,
+		    polaris_cache_size, polaris_cache_path);
+	}
 
 	return 0;
 bad:
@@ -4877,6 +4949,11 @@
 	vn_close(vp, fp->fp_glob->fg_flag, &context);
 	vnode_put(vp);
 	fp_free(p, indx, fp);
+
+	if (polaris_cache_hit) {
+		panic("POLARIS OPENRES late err=%d %s", error,
+		    polaris_cache_path);
+	}
 
 	return error;
 }
