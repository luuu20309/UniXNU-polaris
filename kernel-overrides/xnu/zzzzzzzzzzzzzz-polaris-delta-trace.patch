--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1406,9 +1406,40 @@
 	/*
 	 * Actually load the image file we previously decided to load.
 	 */
+	/*
+	 * The Data mount succeeds and a probe just before this point reported
+	 * 463302 free pages (1810 MiB), while the abort later sees about 512. The
+	 * drop therefore happens while the Mach-O is being loaded. Capture the level
+	 * before the call and report both sides in one panic so a single boot shows
+	 * the delta instead of needing one run per side.
+	 */
+	uint32_t polaris_free_before = 0;
+	uint64_t polaris_pages_before = 0;
+#if defined(XNU_POLARIS_EXEC_TRACE) && XNU_POLARIS_EXEC_TRACE
+	{
+		extern volatile uint32_t vm_page_free_count;
+		extern volatile uint64_t vm_page_pages;
+		polaris_free_before = vm_page_free_count;
+		polaris_pages_before = vm_page_pages;
+	}
+#endif
 	boot_progress_process_stage(proc_getpid(p),p->p_name,"exec load_machfile enter");
 	lret = load_machfile(imgp, mach_header, thread, &map, &load_result);
 	boot_progress_process_stage(proc_getpid(p),p->p_name,"exec load_machfile returned");
+#if defined(XNU_POLARIS_EXEC_TRACE) && XNU_POLARIS_EXEC_TRACE
+	{
+		extern volatile uint32_t vm_page_free_count;
+		extern volatile uint32_t vm_page_wire_count;
+		extern volatile uint32_t vm_page_pageable_internal_count;
+		panic("POLARIS LOADX name=%s lret=%d free %u->%u (d=%d) wire=%u pag=%u pages=%llu",
+		    p->p_name ? p->p_name : "?", lret,
+		    polaris_free_before, (unsigned)vm_page_free_count,
+		    (int)(polaris_free_before - vm_page_free_count),
+		    (unsigned)vm_page_wire_count,
+		    (unsigned)vm_page_pageable_internal_count,
+		    (unsigned long long)polaris_pages_before);
+	}
+#endif
 	if (lret != LOAD_SUCCESS) {
 		error = load_return_to_errno(lret);
 
