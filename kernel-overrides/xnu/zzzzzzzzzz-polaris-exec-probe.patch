--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1186,7 +1186,69 @@
  * Note:	A return value other than -1 indicates subsequent image
  *		activators should not be given the opportunity to attempt
  *		to activate the image.
