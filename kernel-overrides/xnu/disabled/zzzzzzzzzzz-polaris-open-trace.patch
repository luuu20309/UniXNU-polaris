+	/*
+	 * Polaris bring-up probe: remember the last path a non-init process tried
+	 * to open. mount(8) runs with no path arguments, so the useful evidence is
+	 * which file it looked for just before it gave up. Inert unless the
+	 * polaris-opentrace boot argument is set.
+	 */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static int polaris_opentrace = -1;
+		if (polaris_opentrace < 0) {
+			int trace_value = 0;
+			(void)PE_parse_boot_argn("polaris-opentrace", &trace_value,
+			    sizeof(trace_value));
+			polaris_opentrace = trace_value;
+		}
+		if (polaris_opentrace && p != PROC_NULL && proc_getpid(p) != 1 &&
+		    UIO_SEG_IS_USER_SPACE(ndp->ni_segflg)) {
+			size_t traced_len = 0;
+			(void)copyinstr(ndp->ni_dirp, polaris_last_open_path,
+			    sizeof(polaris_last_open_path) - 1, &traced_len);
+			polaris_last_open_pid = proc_getpid(p);
+			polaris_last_open_flags = oflags;
+		}
+	}
