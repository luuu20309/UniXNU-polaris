@@ -7094,12 +7105,35 @@
 	request.flags |= MNT_UNION;
 #endif
 	if (device_vnode) vnode_put(device_vnode);
+	#if defined(XNU_POLARIS_SYSTEMOS_MOUNT) && XNU_POLARIS_SYSTEMOS_MOUNT
+	printf("WARNING: Polaris experimental SystemOS mount uses unverified root and volume\n");
+	root_authorized = (vfs_flags(root_mount) & MNT_RDONLY) && root_device != NODEV;
+	#else
