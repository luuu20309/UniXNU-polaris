+	if (selected == NODEV) goto done;
+	if (polaris_stop == 2) {
+		panic("POLARIS STOP2 path=%s dev=%d", device_path, (int)selected);
+	}
+	#else
 	if (!native_verified_block_volume_device(volume, &selected, device_path,
