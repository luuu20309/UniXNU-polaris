+	}
+	#endif
 #if !defined(XNU_OWNER_UNION_SYSTEMOS) || !XNU_OWNER_UNION_SYSTEMOS
 	if ((error = copyout(environment, environment_vector[0], strlen(environment) + 1)) != 0 ||
 	    (error = copyout(environment_vector, scratch + 0x500, sizeof(environment_vector))) != 0) goto done;
@@ -7146,13 +7211,28 @@
 	if ((error = copyout(fallback, scratch + 0x600, strlen(fallback) + 1)) != 0) goto done;
 #endif
 	*envp = scratch + 0x500;
+	if (polaris_stop == 4) {
+		uint64_t polaris_vec[2] = {0, 0};
+		char polaris_str[96] = {0};
+		(void) copyin(scratch + 0x500, polaris_vec, sizeof(polaris_vec));
+		(void) copyin(scratch + 0x400, polaris_str, sizeof(polaris_str) - 1);
+		panic("POLARIS STOP4 vec=%llx,%llx env=%s",
+		    polaris_vec[0], polaris_vec[1], polaris_str);
+	}
 #else
 	*envp = USER_ADDR_NULL;
 #endif
 	native_owner_cache_stage = 6;
 done:
 	if (mounted_root) vnode_put(mounted_root);
+	#if defined(XNU_POLARIS_SYSTEMOS_MOUNT) && XNU_POLARIS_SYSTEMOS_MOUNT
+	/* Under the union composition rootvnode becomes the new mount, so only
