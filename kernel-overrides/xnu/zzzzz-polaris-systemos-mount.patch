+		panic("POLARIS STOP1 ro=%d dev=%d",
+		    (vfs_flags(root_mount) & MNT_RDONLY) != 0, (int)root_device);
+	}
+	#endif
+	#if defined(XNU_POLARIS_SYSTEMOS_MOUNT) && XNU_POLARIS_SYSTEMOS_MOUNT
