@@ -7074,6 +7081,10 @@
 	int error = EAUTH, root_authorized = 0, cache_authorized = 0;
 	int32_t result = 0;
 	user64_addr_t spec = scratch + 0x160;
+	int polaris_stop = 0;
+#if defined(XNU_POLARIS_DIAG_SYSTEMOS_MOUNT) && XNU_POLARIS_DIAG_SYSTEMOS_MOUNT
