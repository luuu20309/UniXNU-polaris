 	    native_verified_block_root_authorized(root_device);
+	#endif
 	if (!root_authorized) goto done;
 	native_owner_cache_stage = 1;
+	#if defined(XNU_POLARIS_SYSTEMOS_MOUNT) && XNU_POLARIS_SYSTEMOS_MOUNT
